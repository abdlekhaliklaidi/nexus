pipeline {
    agent any

    options {
        ansiColor('xterm')
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        APP_NAME        = '01e_com'
        COMPOSE         = 'docker compose -p 01e_com'
        APP_NETWORK     = '01e_com_default'
        DEPLOY_DIR      = '/opt/01e_com'
        SONAR_HOST_URL  = 'http://sonarqube:9000'
        // JAVA_SERVICES   = 'gateway_service user_service product_service media_service cart_service'
        JAVA_SERVICES   = 'gateway_service user_service product_service media_service cart_service order_service'
        DOCKER_SERVICES = "${JAVA_SERVICES} frontend"
        FRONTEND_PORT   = '8443'
        GATEWAY_PORT    = '8089'
        E2E_BASE_URL    = 'https://frontend:8443'

        NEXUS_HOST      = 'nexus'
        NEXUS_PORT      = '8081'
        NEXUS_URL       = 'http://nexus:8081'

        NEXUS_DOCKER_PORT = '8082'
        NEXUS_DOCKER_URL = '10.1.13.9:8082'
        DOCKER_TAG        = '0.0.1'

    }

    triggers {
        githubPush()

        // Weekly SonarQube health scan.
        // Jenkins hashes the job name to avoid all jobs running simultaneously.
        cron('H H * * 0')
    }

    stages {
        stage('Checkout & Setup Env') {
            steps {
                checkout scm
                withCredentials([file(credentialsId: '01e-com-env-file', variable: 'ENV_FILE')]) {
                    sh 'cp "$ENV_FILE" .env'
                }
            }
        }

        stage('Parallel Automated Testing') {
            parallel {
                stage('Angular Frontend Tests') {
                    agent {
                        docker {
                            image 'zenika/alpine-chrome:with-node'
                            args '-u 0 -v /tmp/npm-cache:/root/.npm'
                            reuseNode true
                        }
                    }
                    steps {
                        dir('client') {
                            sh 'npm ci --legacy-peer-deps --no-audit --no-fund && npm run test:ci'
                        }
                    }
                }

                stage('Java Microservices Unit Tests') {
                    steps {
                        sh '''
                            set -e
                            for dir in ${JAVA_SERVICES}; do
                                echo "==> Running unit tests for ${dir}"
                                (cd "$dir" && chmod +x mvnw && ./mvnw clean test jacoco:report)
                            done
                        '''
                    }
                    post {
                        always {
                            junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
                            jacoco execPattern: '**/target/*.exec', classPattern: '**/target/classes'
                        }
                    }
                }
            }
        }

        stage('SonarQube Scanner Analysis') {
    agent {
        docker {
            image 'sonarsource/sonar-scanner-cli:latest'
            args '--entrypoint="" --network ci-plateform_ci_net'
            reuseNode true
        }
    }

    steps {
        withSonarQubeEnv('SonarQube') {
            sh '''
                set -e

                sonar-scanner \
                  -Dsonar.projectKey=${APP_NAME} \
                  -Dsonar.sources=gateway_service/src/main/java,user_service/src/main/java,product_service/src/main/java,media_service/src/main/java,cart_service/src/main/java,order_service/src/main/java,client/src \
                  -Dsonar.tests=gateway_service/src/test/java,user_service/src/test/java,product_service/src/test/java,media_service/src/test/java,cart_service/src/test/java,order_service/src/test/java \
                  -Dsonar.java.binaries=gateway_service/target/classes,user_service/target/classes,product_service/target/classes,media_service/target/classes,cart_service/target/classes,order_service/target/classes \
                  -Dsonar.coverage.jacoco.xmlReportPaths=**/target/site/jacoco/jacoco.xml \
                  -Dsonar.javascript.lcov.reportPaths=client/coverage/lcov.info \
                  -Dsonar.coverage.exclusions=**/*Application.java,**/config/**,**/dto/**,**/entity/**,**/entities/**,**/event/**,**/model/**,client/src/main.ts,client/src/environments/** \
                  -Dsonar.exclusions=**/node_modules/**,**/target/**,**/*.spec.ts,**/config/**,**/event/**,**/model/**,**/dto/**,**/entity/**
            '''
        }
    }
}


        stage('Quality Gate Check') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    script {
                        def qg = waitForQualityGate()
                        if (qg.status != 'OK') {
                            error "Pipeline aborted due to SonarQube quality gate failure: ${qg.status}"
                        }
                    }
                }
            }
        }

        stage('Build Artifacts & Container Images') {
            environment {
                    DOCKER_BUILDKIT = '1'
                    COMPOSE_DOCKER_CLI_BUILD = '1'
            }
            steps {
                echo 'Building production JAR files concurrently...'

                sh '''
                    set -e
                    for dir in ${JAVA_SERVICES}; do
                        echo "==> Packaging ${dir}"
                        (cd "$dir" && ./mvnw package -DskipTests -T 1C) &
                    done
                    wait
                '''

                echo 'Building Docker container images...'
                sh '${COMPOSE} build'
            }
        }
        
        stage('Publish Docker Images to Nexus') {
    when {
        allOf {
            anyOf {
                branch 'main'
                environment name: 'CHANGE_TARGET', value: 'main'
                expression { env.GIT_BRANCH?.endsWith('main') }
            }
            not { triggeredBy 'TimerTrigger' }
        }
    }
    steps {
        withCredentials([
            usernamePassword(
                credentialsId: 'nexus-maven-publisher',
                usernameVariable: 'NEXUS_USERNAME',
                passwordVariable: 'NEXUS_PASSWORD'
            )
        ]) {
            sh '''
                set -e

                echo "=========================================="
                echo "==> Starting local socat proxy for Nexus HTTP"
                echo "=========================================="

                docker rm -f nexus-proxy || true
                docker run -d --name nexus-proxy --network ci-plateform_ci_net \
                    -p 5000:8082 \
                    alpine/socat \
                    TCP-LISTEN:8082,fork TCP:10.1.13.9:8082

                sleep 3

                PROXY_URL="127.0.0.1:5000"

                echo "=========================================="
                echo "==> Login to Nexus Docker Proxy"
                echo "=========================================="

                echo "$NEXUS_PASSWORD" | docker login "$PROXY_URL" \
                    --username "$NEXUS_USERNAME" \
                    --password-stdin

                for service in ${DOCKER_SERVICES}; do
                    echo "Processing service: ${service}"

                    # Derive variations to safely match built image tags
                    # (e.g., gateway_service vs gateway vs gateway-service)
                    BASE_NAME=$(echo "${service}" | sed 's/_service//g')
                    HYPHEN_NAME=$(echo "${service}" | sed 's/_/-/g')
                    HYPHEN_BASE_NAME=$(echo "${BASE_NAME}" | sed 's/_/-/g')

                    IMAGE_ID=""
                    for pattern in \
                        "${service}" "01e_com-${service}" \
                        "${BASE_NAME}" "01e_com-${BASE_NAME}" \
                        "${HYPHEN_NAME}" "01e_com-${HYPHEN_NAME}" \
                        "${HYPHEN_BASE_NAME}" "01e_com-${HYPHEN_BASE_NAME}"; do
                        if [ -z "$IMAGE_ID" ]; then
                            IMAGE_ID=$(docker images -q "${pattern}" 2>/dev/null | head -n 1 || true)
                        fi
                    done

                    if [ -z "$IMAGE_ID" ]; then
                        echo "ERROR: Docker image not found for service '${service}'"
                        echo "Available docker images:"
                        docker images
                        exit 1
                    fi

                    # Target name mapping for Nexus registry repository
                    TARGET_NAME="${service}"
                    case "${service}" in
                        *frontend*) TARGET_NAME="frontend" ;;
                    esac

                    TARGET_IMAGE="${PROXY_URL}/${TARGET_NAME}:${DOCKER_TAG}"

                    echo "Tagging ${IMAGE_ID} as ${TARGET_IMAGE} and pushing..."
                    docker tag "$IMAGE_ID" "$TARGET_IMAGE"
                    docker push "$TARGET_IMAGE"
                done

                docker logout "$PROXY_URL"
                docker rm -f nexus-proxy || true

                echo "=========================================="
                echo "==> Docker images published successfully"
                echo "=========================================="
            '''
        }
    }
}

        // Nexus Repository Readiness
        stage('Nexus Repository Readiness') {
    when {
        allOf {
            anyOf {
                branch 'main'
                environment name: 'CHANGE_TARGET', value: 'main'
                expression {
                    env.GIT_BRANCH?.endsWith('main')
                }
            }

            not {
                triggeredBy 'TimerTrigger'
            }
        }
    }

    steps {
        sh '''
            set -e

            echo "Checking Nexus DNS..."

            getent hosts nexus

            echo "Checking Nexus HTTP..."

            for i in $(seq 1 60); do

                status=$(curl -sS \
                    -o /dev/null \
                    -w '%{http_code}' \
                    --max-time 10 \
                    "${NEXUS_URL}/service/rest/v1/status" \
                    || true)

                echo "Nexus HTTP status: ${status}"

                if echo "${status}" | grep -q '^2'; then
                    echo "✅ Nexus is ready."
                    exit 0
                fi

                sleep 5
            done

            echo "❌ Nexus did not become ready."
            exit 1
        '''
    }
}

        stage('Publish Maven Artifacts to Nexus') {
    when {
    allOf {
        not {
            triggeredBy 'TimerTrigger'
        }
        anyOf {
            branch 'main'
            expression {
                env.GIT_BRANCH && !env.GIT_BRANCH.endsWith('main')
              }
            }
        }
    }


    steps {
        withCredentials([
            usernamePassword(
                credentialsId: 'nexus-maven-publisher',
                usernameVariable: 'NEXUS_USERNAME',
                passwordVariable: 'NEXUS_PASSWORD'
            )
        ]) {

            sh '''
                set -e

                echo "Creating temporary Maven settings..."

                cat > "$WORKSPACE/settings-nexus.xml" <<EOF
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
          https://maven.apache.org/xsd/settings-1.0.0.xsd">

    <servers>

        <server>
            <id>nexus-releases</id>
            <username>${NEXUS_USERNAME}</username>
            <password>${NEXUS_PASSWORD}</password>
        </server>

        <server>
            <id>nexus-snapshots</id>
            <username>${NEXUS_USERNAME}</username>
            <password>${NEXUS_PASSWORD}</password>
        </server>

        <server>
            <id>nexus-public</id>
            <username>${NEXUS_USERNAME}</username>
            <password>${NEXUS_PASSWORD}</password>
        </server>

    </servers>

    <mirrors>
        <mirror>
            <id>nexus-public</id>
            <name>Nexus Maven Public</name>
            <url>http://nexus:8081/repository/maven-public/</url>
            <mirrorOf>*</mirrorOf>
        </mirror>
    </mirrors>

</settings>
EOF

                for dir in ${JAVA_SERVICES}; do

                    echo "=========================================="
                    echo "==> Deploying ${dir}"
                    echo "=========================================="

                    cd "$WORKSPACE/$dir"

                    ./mvnw deploy \
                        -DskipTests \
                        -s "$WORKSPACE/settings-nexus.xml"

                done
            '''

            sh 'rm -f "$WORKSPACE/settings-nexus.xml"'
        }
    }
}

        stage('Debug Env') {
            steps {
                sh 'echo "BRANCH_NAME: ${BRANCH_NAME}"'
                sh 'echo "GIT_BRANCH: ${GIT_BRANCH}"'
            }
        }

        stage('Deploy Application') {
            when {
                allOf {
                    anyOf {
                        branch 'main'
                        environment name: 'CHANGE_TARGET', value: 'main'
                        expression { env.GIT_BRANCH?.endsWith('main') }
                    }

                    // Never deploy from a scheduled SonarQube scan.
                    not {
                        triggeredBy 'TimerTrigger'
                    }
                }
            }

            steps {
                echo "Deploying service stack to ${DEPLOY_DIR}..."
                sh '''
                    mkdir -p ${DEPLOY_DIR}
                    cp docker-compose.yml ${DEPLOY_DIR}/
                    cp .env ${DEPLOY_DIR}/.env

                    cd ${DEPLOY_DIR}
                    ${COMPOSE} up -d --remove-orphans
                    ${COMPOSE} ps
                '''
            }
        }
    }
    // test
    //trigger
    post {
        always {
            sh 'rm -f .env'
        }

         success {
    echo "🚀 CI/CD SUCCESS"

    script {
        try {
            mail(
                to: 'abdlekhaliklaidi@gmail.com',
                subject: "✅ SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: "Build passed.\nLogs: ${env.BUILD_URL}"
            )
        } catch (Exception e) {
            echo "⚠️ Email notification failed: ${e.message}"
        }
    }
}


        failure {
    echo "❌ CI/CD FAILED"

    script {
        try {
            mail(
                to: 'abdlekhaliklaidi@gmail.com',
                subject: "❌ FAILURE: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: "Build failed.\nLogs: ${env.BUILD_URL}"
            )
        } catch (Exception e) {
            echo "⚠️ Email notification failed: ${e.message}"
        }
    }
}

    }
}
